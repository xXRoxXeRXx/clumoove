# ==============================================================================
# Clumoove — Multi-Cloud Migration Platform
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in the appropriate values for your environment.
# WARNING: NEVER commit the actual '.env' file containing real secrets to VCS!
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL credentials used by Docker Compose.
DB_USER=postgres
DB_PASSWORD=postgres

# Maximum allowed connections. Default: 300.
# Calculation formula: at least 50 + workers * (max(50, 2 * MAX_THREADS) + 1).
POSTGRES_MAX_CONNECTIONS=300

# Optional: Direct PostgreSQL connection string override (used when running outside Docker).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/cloud_migration_db?sslmode=disable


# ── Core Security & Encryption ────────────────────────────────────────────────
# REQUIRED — Strong, random secret for AES-256-GCM credential encryption.
# Generate via: openssl rand -base64 32
# NOTE: Both API gateway and worker require a non-empty value. The encryption layer
# derives its 32-byte AES key by hashing this secret, so base64 is recommended, not required.
ENCRYPTION_SECRET_KEY=

# REQUIRED — HMAC key for signing JWT sessions (MUST differ from ENCRYPTION_SECRET_KEY).
# Generate via: openssl rand -base64 32
JWT_SECRET_KEY=


# ── Redis Queue ───────────────────────────────────────────────────────────────
# REQUIRED for Docker Compose — Strong, deployment-unique password for the internal Redis queue.
# Outside Compose, place the password in REDIS_URL or use REDIS_PASSWORD as its fallback.
# API and worker reject an empty effective password and known default/weak strings.
# Generate via: openssl rand -base64 32
REDIS_PASSWORD=change-me-to-a-strong-unique-value

# Optional: Direct Redis connection URL override (used when running outside Docker).
# REDIS_URL=redis://:your_password@localhost:6379


# ── OAuth Providers (configured in the web UI) ─────────────────────────────────
# Google/OneDrive/Dropbox/HiDrive client credentials are configured by an
# administrator under Administration → System. They are no longer set via
# environment variables. The OAuth redirect URI is always
# <scheme>://<host>/api/oauth/callback and is shown read-only in the admin UI.


# ── Local Storage Sandbox Provider (Optional) ─────────────────────────────────
# Enables server-side local storage provider (reads/writes inside container /clumoove).
# Set LOCAL_STORAGE_HOST_PATH to the host directory to mount into the container.
# Example (Windows): LOCAL_STORAGE_HOST_PATH=D:/clumoove-data
# Example (Linux):   LOCAL_STORAGE_HOST_PATH=/srv/clumoove-data
LOCAL_STORAGE_HOST_PATH=


# ── Security & Reverse Proxy ──────────────────────────────────────────────────
# Set to '1' or 'true' if API is deployed behind a trusted reverse proxy (Nginx/Traefik/Caddy).
# Required for rate-limiting, IP detection & HTTPS header validation (X-Forwarded-For / X-Forwarded-Proto).
TRUSTED_PROXY=0

# SSRF Protection: Set to '1' or 'true' to block outbound connections to RFC1918 private IP ranges.
# Set to '0' (default) if migrating between self-hosted / internal servers on local network.
MIGRATION_BLOCK_PRIVATE=0


# ── Network, Host & Frontend Configuration ─────────────────────────────────────
# Production frontend API origin. Leave empty for same-origin reverse-proxy routing.
# Must be an origin only (for example, https://api.example.com); paths, credentials,
# query strings, and fragments are rejected by the frontend container at startup.
CLUMOOVE_API_URL=

# API URL for the Vite development server only. VITE_* values are compiled into
# the bundle and cannot configure an already-built production frontend image.
VITE_API_URL=http://localhost:8001

# Allowed CORS Origin for production API requests (e.g. https://clumoove.example.com).
CORS_ALLOWED_ORIGIN=

# Frontend base URL (used for email links / reset flows).
FRONTEND_URL=http://localhost:5173

# Allowed hostnames for Vite frontend dev server (comma-separated).
VITE_ALLOWED_HOSTS=


# ── System SMTP (Password Reset & Notifications) ──────────────────────────────
# System mailer credentials. If host is empty, password reset is disabled in UI.
# Encryption mode: 'tls' (implicit SSL, e.g. port 465) or 'starttls' (e.g. port 587).


# ── Concurrency & Performance ─────────────────────────────────────────────────
# Maximum parallel worker tasks per process across all migrations (Default: 50 in prod, 16 in dev).
MAX_THREADS=50

# Maximum duration (in minutes) for source tree BFS indexing (Default: 60).
INDEXING_TIMEOUT_MINUTES=60

# Per-request timeout (in seconds) for WebDAV / Nextcloud PROPFIND listing (Default: 120).
WEBDAV_LISTING_TIMEOUT_SECONDS=120

# Worker-only limit for concurrent immutable backup-pack writers (Default: 1; range: 1..4).
MAX_BACKUP_PACK_WRITERS=1

# Worker-only limit for concurrent full-pack readers shared by restores and repository checks (Default: 1; range: 1..4).
MAX_RESTORE_PACK_READERS=1


# ── Structured Logging ────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_ENVIRONMENT=production
# INSTANCE_ID=api-1
