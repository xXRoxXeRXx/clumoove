server {
    listen 3000;
    server_name localhost;

    include /etc/nginx/mime.types;
    types {
        application/javascript js mjs;
    }

    # Security headers for the SPA documents. The /api/ mux applies its own
    # stricter set; these protect the HTML/asset responses served here.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # X-XSS-Protection is deprecated and can introduce vulnerabilities in legacy
    # browsers; real protection comes from the CSP above. Disable it explicitly.
    add_header X-XSS-Protection "0" always;
    # CLUMOOVE_API_CSP_SOURCE is either empty (same-origin API) or one
    # validated, origin-only HTTP(S) source supplied at container startup.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'${CLUMOOVE_API_CSP_SOURCE}; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;
    # window.open() for the picker tab requires popups to remain referenceable.
    # 'same-origin-allow-popups' keeps document isolation while allowing popups
    # we open (avoids the "Cross-Origin-Opener-Policy would block window.closed"
    # warning when interacting with the opened picker tab).
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;

    # Raw upload bodies are streamed to the API. Keep this location narrower
    # than the general API proxy so normal JSON routes retain their defaults.
    location ~ ^/api/files/profiles/[^/]+/content$ {
        client_max_body_size 0;
        proxy_pass http://api-backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        client_body_timeout 24h;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }

    location /api/ {
        proxy_pass http://api-backend:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for Server-Sent Events (SSE)
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
